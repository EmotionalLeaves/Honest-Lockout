<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the Lockout screen and the Change queued screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hl_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/notice_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/hl_danger"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notice_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/hl_text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/notice_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/hl_text_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/notice_line3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/hl_text_muted"
        android:textSize="15sp" />

    <Button
        android:id="@+id/notice_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/hl_button_primary"
        android:textAllCaps="false"
        android:textColor="@color/hl_on_primary"
        android:textSize="16sp" />
</LinearLayout>
