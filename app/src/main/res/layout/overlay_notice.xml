<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the Lockout screen and the Change queued screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hl_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/notice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/hl_danger"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notice_line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/hl_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/notice_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/hl_pill_bg"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/hl_text_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/notice_line3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/hl_pill_bg"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/hl_text_muted"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/notice_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="24dp"
        android:background="@drawable/hl_button_primary"
        android:textAllCaps="false"
        android:textColor="@color/hl_on_primary"
        android:textSize="16sp"
        android:textStyle="bold" />
</FrameLayout>
