<?xml version="1.0" encoding="utf-8"?>
<!-- Warning and check-in banner: top third of the screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hl_banner_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/banner_seconds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/hl_warning"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/banner_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/hl_text"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/banner_primary"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/hl_button_primary"
            android:textAllCaps="false"
            android:textColor="@color/hl_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/banner_end"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/hl_button_secondary"
            android:text="@string/banner_end_it"
            android:textAllCaps="false"
            android:textColor="@color/hl_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
