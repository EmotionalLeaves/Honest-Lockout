<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/hl_bubble_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/bubble_minutes"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:textColor="@color/hl_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/bubble_done"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/hl_button_primary"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/notif_done"
        android:textAllCaps="false"
        android:textColor="@color/hl_on_primary"
        android:visibility="gone" />
</LinearLayout>
