    <string name="step_notifications_title">Notifications</string>
    <string name="step_notifications_why">Overrides show a timer notification with I\'m done and Extend.\nWarnings and check-ins also arrive as notifications.</string>
    <string name="step_usage_title">Usage access</string>
    <string name="step_usage_why">Daily budgets and screen-time history need to know how long each app was open.\nThis stays on your phone.</string>
    <string name="step_battery_title">Ignore battery optimization</string>
    <string name="step_battery_why">Android stops background apps to save power.\nWithout this exemption, blocking can quietly stop working.</string>
    <string name="step_samsung_title">Samsung: never sleeping</string>
    <string name="step_samsung_why">Samsung phones put apps to sleep on their own.\nThis cannot be checked automatically, so it is a reminder.</string>
    <string name="step_samsung_note">Open Battery, then Background usage limits, then Never sleeping apps, and add Honest Lockout.</string>
    <string name="step_overlay_title">Display over other apps</string>
    <string name="step_overlay_why">Warnings, check-ins and the timer bubble are drawn on top of the app you are using.\nThe lock screen itself works without it.</string>
    <string name="step_restricted_title">Allow restricted settings</string>
    <string name="step_restricted_why">Android 13 and later grey out accessibility for apps installed outside the Play Store.\nAllow it once from App info.</string>
    <string name="step_restricted_1">Tap Open settings to open App info.</string>
    <string name="step_restricted_2">Tap the ⋮ menu in the top corner.</string>
    <string name="step_restricted_3">Tap Allow restricted settings, then come back.</string>
    <string name="step_accessibility_title">Accessibility service</string>
    <string name="step_accessibility_why">This is how the app sees which app is open and covers blocked ones.\nFind Honest Lockout in the list and turn it on.</string>
    <string name="step_accessibility_greyed">Toggle greyed out? Allow restricted settings in App info first (step 5), then try again.</string>
    <string name="step_admin_title">Device admin (optional)</string>
    <string name="step_admin_why">With device admin on, uninstalling needs it turned off first, and turning it off waits 24 hours.\nYou can skip this.</string>
    <string name="device_admin_explanation">Uninstalling Honest Lockout will require turning this off first. Honest Lockout uses no device admin policies.</string>
    <string name="device_admin_disable_warning">Turning this off is a loosening and will be queued for 24 hours.</string>

